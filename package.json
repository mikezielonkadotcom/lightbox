		"lint:js": "wp-scripts lint-js --ignore-pattern assets --ignore-pattern release --ignore-pattern node_modules",
		"test:js": "wp-scripts test-unit-js --runInBand"
	},
	"dependencies": {},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^7.29.7",
		"@babel/plugin-transform-runtime": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@wordpress/components": "^37.0.0",
		"@wordpress/element": "^8.3.0",
		"@wordpress/i18n": "^6.24.0",
		"@wordpress/scripts": "^33.0.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	}
}
